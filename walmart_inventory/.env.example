# Walmart Marketplace API
# Seller Center → Settings → API Settings で取得
WALMART_CLIENT_ID=your-client-id
WALMART_CLIENT_SECRET=your-client-secret

# 通知設定 (email または slack)
NOTIFY_TYPE=email

# --- メール通知の場合 ---
NOTIFY_EMAIL=your-sender@gmail.com
NOTIFY_EMAIL_PASSWORD=your-app-password   # Gmailはアプリパスワード
NOTIFY_EMAIL_PROVIDER=gmail               # gmail / outlook
NOTIFY_RECIPIENTS=your@email.com,colleague@email.com  # カンマ区切りで複数可

# --- Slack通知の場合 ---
# NOTIFY_TYPE=slack
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
