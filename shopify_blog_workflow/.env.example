# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# Google API (Google Docs書き込み用)
# credentials/google_service_account.json に認証情報を配置
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json

# ブログ設定
BLOG_LANGUAGE=en
BLOG_TARGET_MARKET=US
BLOG_WORD_COUNT=800

# (Phase 2以降) Shopify
# SHOPIFY_STORE_URL=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxx

# (Phase 3以降) Facebook / Instagram
# META_APP_ID=xxxxxxxxxx
# META_APP_SECRET=xxxxxxxxxx
# META_ACCESS_TOKEN=xxxxxxxxxx
