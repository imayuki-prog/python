# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# Google API (Google Docs書き込み用)
GOOGLE_CREDENTIALS_PATH=credentials/google_service_account.json
GOOGLE_DRIVE_FOLDER_ID=xxxxxxxxxx

# ブログ設定
BLOG_LANGUAGE=en
BLOG_TARGET_MARKET=US
BLOG_WORD_COUNT=800

# Shopify
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxx
# get_shopify_token.py が自動で書き込みます
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxx
SHOPIFY_BLOG_ID=xxxxxxxxxx

# Facebook / Instagram (Phase 3)
META_APP_ID=xxxxxxxxxx
META_APP_SECRET=xxxxxxxxxx
# ページが見つからない場合のフォールバック用ビジネスポートフォリオID（任意）
META_BUSINESS_ID=
# 以下は get_facebook_token.py が自動で書き込みます
FACEBOOK_PAGE_ID=xxxxxxxxxx
INSTAGRAM_ACCOUNT_ID=xxxxxxxxxx
META_ACCESS_TOKEN=xxxxxxxxxx
META_USER_ACCESS_TOKEN=xxxxxxxxxx
