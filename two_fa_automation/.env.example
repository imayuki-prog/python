# 2FA自動化の設定ファイル（.env.exampleをコピーして.envにリネーム）

# 2FAコードが届くメールアカウント
TWO_FA_EMAIL=your-shared-email@gmail.com
TWO_FA_EMAIL_PASSWORD=your-gmail-app-password  # Gmailはアプリパスワードを使用
TWO_FA_EMAIL_PROVIDER=gmail  # gmail / outlook / yahoo

# Amazon アカウント
AMAZON_EMAIL=your-amazon-account@email.com
AMAZON_PASSWORD=your-amazon-password

# Walmart アカウント
WALMART_EMAIL=your-walmart-account@email.com
WALMART_PASSWORD=your-walmart-password
